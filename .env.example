# Kopier til .env og fyll inn det du trenger. Selve .env er gitignored.
# MERK: dbdemo har nå first-run-oppsett — admin-bruker og DB-tilkoblinger
# fylles inn via /setup ved første kjøring og lagres i ~/.dbdemo/dbconfig.json.
# Miljøvariablene nedenfor er valgfrie overstyringer.

# Konfigurasjonsfil-sti (default: ~/.dbdemo/dbconfig.json)
# DBDEMO_CONFIG=/path/to/dbconfig.json

# Query-begrensninger
QUERY_TIMEOUT_SECONDS=15
QUERY_MAX_ROWS=10000
DB_READONLY=true
