# Kopier til .env og fyll inn hemmelighetene. Selve .env er gitignored.
# Eksempel:  cp .env.example .env && $EDITOR .env

# App-innlogging
APP_USER=kurs
APP_PASSWORD=kurs123

# Database-servere
DB_HOST=noderia.com
DB_HOST_ORACLE=itfakultetet.no
DB_PORT_ORACLE=1521
DB_PORT_MSSQL=1433
ORACLE_SERVICE=HR

# Database-brukere (hemmeligheter — fyll inn!)
PG_USERNAME=dbdemo
PG_PWD=
MS_USERNAME=kurs
MS_PWD=
OR_USERNAME=hr
OR_PWD=
MY_USERNAME=kurs
MY_PWD=

# Query-begrensninger
QUERY_TIMEOUT_SECONDS=15
QUERY_MAX_ROWS=10000
DB_READONLY=true
